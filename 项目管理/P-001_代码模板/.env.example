# ============================================
# P-001 邀测招募 - 环境变量配置模板
# ============================================
# 将此文件复制为 .env，并填入实际的值

# 运行环境
ENVIRONMENT=development  # development 或 production

# ============ Google Sheets 配置 ============
GOOGLE_SHEET_ID=1a2b3c4d5e6f7g8h9i10j11k12l13m14n15o16p17q
GOOGLE_CREDENTIALS_FILE=google-credentials.json

# ============ 企业微信配置 ============
WECHAT_CORP_ID=wwd3c123456789abcdef1234567890ab
WECHAT_AGENT_ID=1000002
WECHAT_SECRET=abcdefghijklmnopqrstuvwxyz1234567890abcd

# ============ QQ机器人配置 ============
QQ_BOT_TOKEN=your_qq_bot_token_here
QQ_BOT_ENABLED=false  # 可选，默认disabled

# ============ 邀请链接配置 ============
INVITE_DOMAIN=https://invite.yourapp.com
INVITE_REDIRECT_URL=https://form.jotform.com/your-form-id

# ============ 定时任务配置 ============
REWARD_CALC_HOUR=6      # 激励计算时间（小时）
REWARD_DIST_HOUR=9      # 激励发放时间（小时）
FEEDBACK_SYNC_HOUR=12   # 反馈同步时间（小时）
REPORT_HOUR=17          # 周报生成时间（小时）

# ============ 通知配置 ============
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx  # 可选
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx  # 可选
EMAIL_SMTP_SERVER=smtp.gmail.com  # 可选
EMAIL_SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE=logs/recruitment.log

# ============ 其他配置 ============
BOT_NAME=邀测招募机器人
TIMEZONE=Asia/Shanghai
